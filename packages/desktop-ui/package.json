{
  "name": "@deepkit/desktop-ui",
  "version": "1.0.19",
  "description": "Library for desktop UI widgets in Angular 10+",
  "keywords": [
    "Desktop",
    "UI",
    "MacOS"
  ],
  "bin": {
    "dui-create-font": "./bin/create-font.js"
  },
  "repository": "https://github.com/deepkit/deepkit-framework",
  "author": "Marc J. Schmidt <marc@marcjschmidt.de>",
  "license": "MIT",
  "sideEffects": false,
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    "./package.json": {
      "default": "./package.json"
    },
    "./src/scss/all.scss": {
      "default": "./src/scss/all.scss"
    },
    "./src/scss/icon.scss": {
      "default": "./src/scss/icon.scss"
    },
    "./src/scss/reset.scss": {
      "default": "./src/scss/reset.scss"
    },
    ".": {
      "types": "./dist/types/deepkit-desktop-ui.d.ts",
      "default": "./dist/fesm2022/deepkit-desktop-ui.mjs"
    }
  },
  "scripts": {
    "font": "node bin/create-font.js",
    "build": "npm run font && rm -rf .angular && ng-packagr --config tsconfig.prod.json && rm -f dist/.npmignore",
    "test": "ng test --watch=false",
    "watch": "ng-packagr --config tsconfig.prod.json --watch",
    "prepublishOnly": "webpack && node bin/create-font.js"
  },
  "browserslist": [
    "last 2 Chrome versions"
  ],
  "dependencies": {
    "on-change": "^4.0.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@angular-devkit/build-angular": "^22.2.5",
    "@angular/cdk": "^22.2.5",
    "@angular/cli": "^22.2.5",
    "@angular/common": "^22.2.4",
    "@angular/compiler": "^22.2.4",
    "@angular/compiler-cli": "^22.2.4",
    "@angular/core": "^22.2.4",
    "@angular/forms": "^22.2.4",
    "@angular/platform-browser": "^22.2.4",
    "@angular/router": "^22.2.4",
    "@deepkit/core": "^1.0.19",
    "@deepkit/core-rxjs": "^1.0.19",
    "@deepkit/event": "^1.0.19",
    "@deepkit/rpc": "^1.0.19",
    "@deepkit/type": "^1.0.19"
  },
  "devDependencies": {
    "@angular/build": "^22.2.5",
    "@deepkit/core": "^1.0.19",
    "@deepkit/core-rxjs": "^1.0.19",
    "@deepkit/event": "^1.0.19",
    "@deepkit/rpc": "^1.0.19",
    "@deepkit/type": "^1.0.19",
    "@types/node": "^22.13.1",
    "ng-packagr": "^22.2.5",
    "rxjs": "~7.8.0",
    "svg2ttf": "^4.2.0",
    "svgicons2svgfont": "^9.0.4",
    "ts-loader": "^9.4.2",
    "ttf2woff": "^2.0.1",
    "webpack": "^5.75.0",
    "webpack-cli": "^5.0.0"
  },
  "gitHead": "c1d3a8fba42c89448ee51a0fa42d1b7281edd86c"
}
